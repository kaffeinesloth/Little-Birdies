# ── Copy file này thành .env và điền giá trị thực ──────────────────

# Google AI (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=

# Models (để mặc định là ổn)
INTENT_MODEL=gemini-1.5-flash
RAG_MODEL=gemini-1.5-pro
EMBEDDING_MODEL=models/text-embedding-004

# Supabase (Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_role_key

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db

# Firebase (download từ Firebase Console > Project Settings > Service Accounts)
FCM_CREDENTIALS_PATH=./firebase-credentials.json

# App
DEBUG=false
API_SECRET_KEY=your-random-secret-key-here

# RAG params (để mặc định hoặc tune sau)
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.60
