# Legacy copy of .env.example. Prefer ai_service/.env.example.

# Google AI / Gemini API
GOOGLE_API_KEY=

# Models
INTENT_MODEL=gemini-1.5-flash
RAG_MODEL=gemini-1.5-pro
EMBEDDING_MODEL=text-embedding-004

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db

# Firebase (download từ Firebase Console > Project Settings > Service Accounts)
FCM_CREDENTIALS_PATH=./firebase-credentials.json

# App
DEBUG=false
API_SECRET_KEY=

# RAG params (để mặc định hoặc tune sau)
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.60
