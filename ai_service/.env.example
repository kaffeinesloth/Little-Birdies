# Optional AI service configuration.
# The Docker fallback demo works without this file or any API keys.

# Optional Supabase persistence
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional hosted Gemini provider
GOOGLE_API_KEY=

# Local AI. Run Docker Compose with the local-ai profile to start Ollama.
AI_PROVIDER=auto
OLLAMA_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3:8b-q4_K_M
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT_SECONDS=90

# Hosted model names
INTENT_MODEL=gemini-1.5-flash
RAG_MODEL=gemini-1.5-pro
EMBEDDING_MODEL=text-embedding-004

# Paths for a non-Docker local run. Docker Compose overrides these paths.
CHROMA_PERSIST_DIR=./chroma_db
LOCAL_KNOWLEDGE_DIR=./local_knowledge

# Backend URL for a non-Docker local run
BACKEND_URL=http://localhost:8000
