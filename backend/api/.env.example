APP_ENV=development
DEBUG=true
LOCAL_MOCK_AUTH_ENABLED=true
LOCAL_MOCK_DB_ENABLED=true
LOCAL_SQLITE_DB_PATH=../data/local_demo.sqlite3
MAX_REQUEST_BODY_BYTES=10485760
MAX_DOCUMENT_UPLOAD_BYTES=10485760
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AI_SERVICE_URL=http://127.0.0.1:8001

# Supabase real database mode:
# 1. Fill these values.
# 2. Set LOCAL_MOCK_DB_ENABLED=false.
# 3. Keep LOCAL_MOCK_AUTH_ENABLED=true for local demo login, or set false
#    after Flutter apps are wired to real Supabase Auth.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=

FACEBOOK_VERIFY_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_WEBHOOK_SIGNING_KEY=
MAILGUN_FROM_EMAIL=
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_PUBLIC_KEY=
SENDGRID_FROM_EMAIL=
OUTBOUND_EMAIL_PROVIDER=mailgun
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
