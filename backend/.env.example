# ============================================================
# Smart Helpdesk — Environment Variables
# Copy file này thành .env và điền giá trị thực
# KHÔNG commit file .env lên Git
# ============================================================

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key   # Dùng để bypass RLS (AI bot tạo ticket)

# AI Service (chạy local hoặc deploy riêng)
AI_SERVICE_URL=http://localhost:8001

# Docker internal URL override
# AI_SERVICE_URL=http://ai-service:8001

# Facebook Messenger Webhook
FB_VERIFY_TOKEN=your-random-verify-token     # Tự đặt, dùng khi đăng ký webhook trên Meta
FB_APP_SECRET=your-facebook-app-secret       # Lấy từ Meta Developer Portal

# Zalo Official Account demo
ZALO_APP_ID=your-zalo-app-id
ZALO_OA_ID=your-zalo-official-account-id
ZALO_OA_SECRET_KEY=your-zalo-oa-secret-key
ZALO_ACCESS_TOKEN=your-zalo-access-token
ZALO_REFRESH_TOKEN=your-zalo-refresh-token

# Email Webhook (Mailgun)
MAILGUN_SIGNING_KEY=your-mailgun-signing-key # Lấy từ Mailgun Dashboard > Webhooks
