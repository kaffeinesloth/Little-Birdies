# Optional backend configuration.
# The Docker demo works without this file by using its in-memory data store.
# Copy to backend/.env only when connecting external services. Never commit it.

# Optional persistent Supabase database
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Service URL for a non-Docker local run. Docker Compose overrides this value.
AI_SERVICE_URL=http://localhost:8001

# Optional Facebook Messenger webhook
FB_VERIFY_TOKEN=
FB_APP_SECRET=

# Optional inbound email webhook
MAILGUN_SIGNING_KEY=
