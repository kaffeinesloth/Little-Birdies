# Copy this file to .env only if you want to change these defaults.
# The standard Docker demo works without any .env files or external accounts.

# Optional Supabase Realtime values for browser clients
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI mode: auto uses Ollama when its configured model is ready, otherwise the
# deterministic offline fallback. The local-ai profile starts Ollama.
AI_PROVIDER=auto
OLLAMA_CHAT_MODEL=qwen3:8b-q4_K_M
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Browser build URLs. Keep localhost when presenting on the Docker laptop.
STAFF_API_BASE_URL=http://localhost:8000
STAFF_AI_BASE_URL=http://localhost:8001
STORE_API_BASE_URL=http://localhost:8000
