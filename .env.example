# Shared
APP_ENV=development
APP_NAME=Smart Helpdesk AI

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
AI_SERVICE_URL=http://localhost:8001
LOCAL_MOCK_AUTH_ENABLED=true
LOCAL_MOCK_DB_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_REQUEST_BODY_BYTES=1048576
MAX_MESSAGE_CONTENT_CHARS=4000
PUBLIC_ENDPOINT_RATE_LIMIT=60
PUBLIC_ENDPOINT_RATE_WINDOW_SECONDS=60

# AI service
AI_HOST=0.0.0.0
AI_PORT=8001
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_DB_PATH=./chroma
RAG_CONFIDENCE_THRESHOLD=0.72
MAX_MESSAGE_CONTENT_CHARS=4000

# Channel integrations
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_WEBHOOK_SIGNING_KEY=
MAILGUN_FROM_EMAIL=
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_PUBLIC_KEY=
SENDGRID_FROM_EMAIL=
OUTBOUND_EMAIL_PROVIDER=mailgun

# Push notifications
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
